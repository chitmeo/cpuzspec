<Window x:Class="SystemInfoTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SystemInfoTool.Views"
        mc:Ignorable="d"
        Title="System Info Tool"
        MinWidth="800" MinHeight="600"
        Width="1000" Height="700"
        Background="{DynamicResource WindowBackgroundBrush}"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- Slider style for refresh interval -->
        <Style x:Key="RefreshSliderStyle" TargetType="Slider">
            <Setter Property="Minimum"          Value="500"/>
            <Setter Property="Maximum"          Value="10000"/>
            <Setter Property="TickFrequency"    Value="500"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Width"            Value="140"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ================================================================
             Menu Bar
             ================================================================ -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="4,2">

            <!-- File menu -->
            <MenuItem Header="_File">
                <MenuItem Header="_Export Snapshot"
                          Command="{Binding ExportSnapshotCommand}"
                          InputGestureText="Ctrl+E"/>
                <Separator/>
                <MenuItem Header="E_xit"
                          Command="{Binding ExitCommand}"
                          InputGestureText="Alt+F4"/>
            </MenuItem>

            <!-- View menu -->
            <MenuItem Header="_View">
                <MenuItem Header="Refresh Interval" IsEnabled="False"
                          FontWeight="SemiBold"/>
                <Separator/>
                <MenuItem IsHitTestVisible="False" Padding="8,4">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="500 ms"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,0,6,0"/>
                            <Slider Style="{StaticResource RefreshSliderStyle}"
                                    Value="{Binding RefreshIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="10 s"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="6,0,12,0"/>
                            <TextBlock Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} ms">
                                        <Binding Path="RefreshIntervalMs"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ================================================================
             Status Bar
             ================================================================ -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource PanelBackgroundBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0"
                   Height="24">
            <StatusBarItem>
                <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}"
                           FontSize="{DynamicResource SmallFontSize}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Refresh: {0} ms">
                            <Binding Path="RefreshIntervalMs"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Busy…"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="{DynamicResource SmallFontSize}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ================================================================
             Main Tab Control
             ================================================================ -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    Margin="0">

            <TabItem Header="CPU">
                <views:CpuView DataContext="{Binding CpuViewModel}"/>
            </TabItem>

            <TabItem Header="Motherboard">
                <views:MotherboardView DataContext="{Binding MotherboardViewModel}"/>
            </TabItem>

            <TabItem Header="Memory">
                <views:MemoryView DataContext="{Binding MemoryViewModel}"/>
            </TabItem>

            <TabItem Header="Graphics">
                <views:GraphicsView DataContext="{Binding GraphicsViewModel}"/>
            </TabItem>

            <TabItem Header="Storage">
                <views:StorageView DataContext="{Binding StorageViewModel}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
